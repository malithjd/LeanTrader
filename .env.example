# Copy this file to .env and fill in your own keys. Never commit .env (it is gitignored).
#   cp .env.example .env

# Massive news (python news.py pull-massive). Free key: https://massive.com
MASSIVE_API_KEY=

# Alpaca news (python news.py pull-alpaca). Free key: https://alpaca.markets
# (Dashboard -> API Keys; paper-trading keys work for news)
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Gemini teacher labels (python teacher.py label). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Hugging Face token for faster FNSPID downloads (python news.py pull-fnspid)
# HF_TOKEN=
